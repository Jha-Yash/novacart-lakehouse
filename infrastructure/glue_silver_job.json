{
  "Name": "novacart-silver-curation",
  "Description": "NovaCart Silver Curation Pipeline (Bronze to Iceberg Silver with Deduplication & Cleansing)",
  "Role": "arn:aws:iam::125992594465:role/NovaCartGlueRole",
  "ExecutionProperty": {
    "MaxConcurrentRuns": 1
  },
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "s3://novacart-order-analytics-125992594465-ap-southeast-2/scripts/silver_curation.py",
    "PythonVersion": "3"
  },
  "DefaultArguments": {
    "--job-language": "python",
    "--datalake-formats": "iceberg",
    "--enable-glue-datacatalog": "true",
    "--enable-continuous-cloudwatch-log": "true",
    "--enable-metrics": "true",
    "--conf": "spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions --conf spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog --conf spark.sql.catalog.glue_catalog.warehouse=s3://novacart-order-analytics-125992594465-ap-southeast-2/iceberg-warehouse/ --conf spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog --conf spark.sql.catalog.glue_catalog.io-impl=org.apache.iceberg.aws.s3.S3FileIO"
  },
  "MaxRetries": 0,
  "GlueVersion": "4.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "Timeout": 20
}
